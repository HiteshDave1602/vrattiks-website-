# Absolute origin of the deployed site, no trailing slash.
# Used for the URLs in /sitemap.xml and /robots.txt.
# Falls back to https://vrattiks.io when unset.
NEXT_PUBLIC_SITE_URL=https://vrattiks.io

# Contact form email (Gmail SMTP). GMAIL_APP_PASSWORD is a Google App Password
# (Google Account > Security > App passwords), not the normal account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional, comma-separated; defaults to GMAIL_USER.
OWNER_EMAIL=
